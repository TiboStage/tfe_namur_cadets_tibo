{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'forgot_password.browser_title'|trans }}{% endblock %}

{% block body %}
<div class="auth-fullpage">

    {% include 'website/_partials/_auth_brand.html.twig' %}

    <section class="auth-forms">
        <div class="auth-forms__inner">

            <div class="auth-form-panel auth-form-panel--centered">

                <h1 class="auth-form-title">{{ 'forgot_password.title'|trans }}</h1>
                <p class="auth-form-subtitle">{{ 'forgot_password.subtitle'|trans }}</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {{ component('Alert', { type: label, message: message }) }}
                    {% endfor %}
                {% endfor %}

                {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="auth-field">
                        {{ form_widget(requestForm.email, {
                            'attr': {'placeholder': 'forgot_password.email'|trans, 'autofocus': 'autofocus'}
                        }) }}
                        {{ form_errors(requestForm.email) }}
                    </div>

                    <div class="auth-captcha"
                         data-controller="turnstile"
                         data-turnstile-sitekey-value="{{ turnstile_site_key }}"></div>

                    <button type="submit" class="btn btn--cta-yellow auth-submit">
                        {{ 'forgot_password.submit'|trans }}
                    </button>

                {{ form_end(requestForm) }}

                <a href="{{ path('app_login', {_locale: app.request.locale}) }}" class="auth-back-link">
                    {{ ux_icon('lucide:arrow-left', {style: 'width:13px;height:13px'}) }}
                    {{ 'forgot_password.back_to_login'|trans }}
                </a>

            </div>

        </div>
    </section>

</div>
{% endblock %}
