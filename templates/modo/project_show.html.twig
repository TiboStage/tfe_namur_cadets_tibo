{# templates/modo/project_show.html.twig #}
{% extends 'modo/layout.html.twig' %}

{% block title %}Modo — {{ project.title }}{% endblock %}
{% block modo_title %}Examen du projet{% endblock %}

{% block modo_content %}
    {% embed 'admin/_partials/_project_review.html.twig' %}
        {% block back_link %}
            <a href="{{ path('modo_reports', {_locale: app.request.locale}) }}" class="admin-back-link">← Retour aux projets signalés</a>
        {% endblock %}
        {% block actions %}
            {{ include('admin/_partials/_moderation_actions.html.twig', {
                action_url: path('modo_project_review', {id: project.id, _locale: app.request.locale}),
                token_id:   'modo_review_' ~ project.id,
                statuses:   ['clear', 'warning', 'blocked'],
            }) }}
            <p class="admin-form-hint">L'approbation définitive est réservée aux administrateurs.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
