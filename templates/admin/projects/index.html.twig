{# templates/admin/projects/index.html.twig #}
{% extends 'admin/layout.html.twig' %}

{% block title %}Admin — Projets{% endblock %}
{% block admin_title %}Gestion des projets{% endblock %}

{% block admin_content %}

    {# ── Filtres ───────────────────────────────────────────────────── #}
    <div class="admin-toolbar">
        <div class="admin-filter-tabs">
            <a href="{{ path('admin_projects', {_locale: app.request.locale, filter: 'all', sort: sort}) }}"
               class="filter-tab {{ filter == 'all' ? 'active' : '' }}">
                Tous <span class="filter-count">{{ counts.all }}</span>
            </a>
            <a href="{{ path('admin_projects', {_locale: app.request.locale, filter: 'public', sort: sort}) }}"
               class="filter-tab {{ filter == 'public' ? 'active' : '' }}">
                Publics <span class="filter-count">{{ counts.public }}</span>
            </a>
            <a href="{{ path('admin_projects', {_locale: app.request.locale, filter: 'flagged', sort: sort}) }}"
               class="filter-tab {{ filter == 'flagged' ? 'active' : '' }} {{ counts.flagged > 0 ? 'filter-tab--alert' : '' }}"
               title="Projets signalés, en avertissement ou bloqués">
                À traiter <span class="filter-count">{{ counts.flagged }}</span>
            </a>
        </div>

        <select class="admin-search-input admin-sort-select"
                onchange="if (this.value) window.location.href = this.value;">
            <option value="{{ path('admin_projects', {_locale: app.request.locale, filter: filter, sort: 'created_desc'}) }}" {{ sort == 'created_desc' ? 'selected' : '' }}>Plus récents</option>
            <option value="{{ path('admin_projects', {_locale: app.request.locale, filter: filter, sort: 'created_asc'}) }}" {{ sort == 'created_asc' ? 'selected' : '' }}>Plus anciens</option>
            <option value="{{ path('admin_projects', {_locale: app.request.locale, filter: filter, sort: 'title_asc'}) }}" {{ sort == 'title_asc' ? 'selected' : '' }}>Titre (A-Z)</option>
            <option value="{{ path('admin_projects', {_locale: app.request.locale, filter: filter, sort: 'reports_desc'}) }}" {{ sort == 'reports_desc' ? 'selected' : '' }}>Signalements</option>
        </select>
    </div>

    <div class="panel-box panel-box--flush">
        <div class="table-wrapper">
            <table class="admin-table">
                <thead><tr>
                    <th>#</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Type</th>
                    <th>Visibilité</th>
                    <th>Modération</th>
                    <th>Signalements</th>
                    <th>Créé le</th>
                    <th></th>
                </tr></thead>
                <tbody>
                {% set type_labels = {film: 'Film', serie: 'Série', jeu_video: 'Jeu vidéo', custom: 'Personnalisé'} %}
                {% set mod_labels  = {clear: 'Neutre', warning: 'Avertissement', blocked: 'Bloqué', approved: 'Approuvé'} %}
                {% for project in projects %}
                    <tr>
                        <td class="text-muted">{{ project.id }}</td>
                        <td><a href="{{ path('admin_project_show', {id: project.id, _locale: app.request.locale}) }}" class="mod-project__title">{{ project.title }}</a></td>
                        <td>
                            <a href="{{ path('admin_user_show', {id: project.createdBy.id, _locale: app.request.locale}) }}" class="mod-author">
                                {{ include('_partials/_user_avatar.html.twig', {user: project.createdBy, size: 'xs'}) }}
                                <span>{{ project.createdBy.username }}</span>
                            </a>
                        </td>
                        <td><span class="admin-badge admin-badge--type-{{ project.projectType }}">{{ type_labels[project.projectType] ?? project.projectType }}</span></td>
                        <td>
                            {% if project.visibility == 'public' %}
                                <span class="admin-badge admin-badge--success">En ligne</span>
                            {% elseif project.visibility == 'private' %}
                                <span class="admin-badge admin-badge--warning">Privé</span>
                            {% else %}
                                <span class="admin-badge admin-badge--muted">Non publié</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="mod-badge mod-badge--{{ project.moderationStatus }}">{{ mod_labels[project.moderationStatus] ?? project.moderationStatus }}</span>
                        </td>
                        <td>
                            {% if project.reportCount > 0 %}
                                <span class="admin-badge admin-badge--danger">{{ project.reportCount }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ project.createdAt|date('d/m/Y') }}</td>
                        <td>
                            <a href="{{ path('admin_project_show', {id: project.id, _locale: app.request.locale}) }}" class="btn-sm btn-sm--outline">Voir</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="text-muted td-empty">Aucun projet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if pages > 1 %}
        <div class="admin-pagination">
            <a href="{{ path('admin_projects', {_locale: app.request.locale, filter: filter, sort: sort, page: page - 1}) }}"
               class="btn-table {{ page <= 1 ? 'is-disabled' : '' }}">&larr; Précédent</a>
            <span class="admin-pagination-status">Page {{ page }} / {{ pages }}</span>
            <a href="{{ path('admin_projects', {_locale: app.request.locale, filter: filter, sort: sort, page: page + 1}) }}"
               class="btn-table {{ page >= pages ? 'is-disabled' : '' }}">Suivant &rarr;</a>
        </div>
    {% endif %}

{% endblock %}
