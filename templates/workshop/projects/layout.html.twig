{% extends 'base.html.twig' %}

{# ══════════════════════════════════════════════════════════
   LAYOUT WORKSPACE PROJET

   Ce layout affiche :
   - Sidebar projet (gauche)
   - Zone de contenu (droite)

   La navbar principale (Mes projets, etc.) n'est PAS affichée
   ══════════════════════════════════════════════════════════ #}

{% block body_class %}workspace-layout{% endblock %}


{% block body %}
{# ══════════════════════════════════════════════════════════
   Le data-controller="modal" doit englober TOUT le contenu
   pour que les data-action="click->modal#open" des triggers
   puissent remonter jusqu'à lui via la chaîne d'ancêtres.
   ══════════════════════════════════════════════════════════ #}
<div data-controller="modal confirm-modal">

    {% include 'workshop/_partials/_topbar.html.twig' %}

    <div class="workspace-body">
        {% include 'workshop/_partials/_project_bar.html.twig' %}

        <main class="workspace-main">
            <div class="workspace-content">
                {% block project_content %}{% endblock %}
            </div>
        </main>
    </div>

    {# ══════════════════════════════════════════════════════════
       MODAL GLOBAL — overlay cible du controller
       data-modal-target="overlay" permet au controller de
       manipuler cet élément via this.overlayTarget
       ══════════════════════════════════════════════════════════ #}
    <div class="ws-modal"
         data-modal-target="overlay"
         data-action="click->modal#backdropClick">
        <div class="ws-modal-box">
            <button type="button"
                    class="ws-modal-close-btn"
                    data-action="modal#close"
                    aria-label="{{ 'common.close'|trans({}, 'workshop') }}">
                {{ ux_icon('lucide:x', {class: 'icon-sm'}) }}
            </button>
            <turbo-frame id="modal-frame">
                <div class="ws-modal-loading">
                    <span class="ws-modal-spinner"></span>
                </div>
            </turbo-frame>
        </div>
    </div>

    {# ══════════════════════════════════════════════════════════
       POPUP DE CONFIRMATION GLOBAL — remplace window.confirm()
       ══════════════════════════════════════════════════════════ #}
    <div class="confirm-modal"
         data-confirm-modal-target="overlay"
         data-action="click->confirm-modal#backdropClick">
        <div class="confirm-modal-box">
            <div class="confirm-modal-icon">
                {{ ux_icon('lucide:triangle-alert', {class: 'icon-md'}) }}
            </div>
            <p class="confirm-modal-message" data-confirm-modal-target="message"></p>
            <div class="confirm-modal-actions">
                <button type="button" class="btn-export" data-action="click->confirm-modal#cancel">
                    {{ 'common.cancel'|trans({}, 'workshop') }}
                </button>
                <button type="button"
                        class="btn-danger"
                        data-confirm-modal-target="confirmBtn"
                        data-action="click->confirm-modal#confirm">
                    {{ 'common.delete'|trans({}, 'workshop') }}
                </button>
            </div>
        </div>
    </div>

</div>
{% endblock %}
