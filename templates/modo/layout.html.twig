{# templates/modo/layout.html.twig #}
{% extends 'base.html.twig' %}

{% set current_route = app.request.attributes.get('_route') %}

{% block body %}
    <div class="modo-layout modo-layout--modo">

        {# ── SIDEBAR (structure calquée sur .project-bar) ──────────── #}
        <aside class="modo-sidebar">

            <div class="modo-sidebar__header">
                <span class="brand-dot brand-dot--modo"></span>
                <span class="modo-sidebar__brand">Scénart <span class="brand-badge brand-badge--modo">Modo</span></span>
            </div>

            <nav class="modo-nav">
                <a href="{{ path('modo_dashboard', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route == 'modo_dashboard' ? 'active' : '' }}">
                    {{ ux_icon('lucide:layout-dashboard', {class: 'icon-sm'}) }}
                    <span>{{ 'modo.menu.dashboard'|trans({}, 'admin') }}</span>
                </a>
                <a href="{{ path('modo_reports', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route == 'modo_reports' or current_route == 'modo_project_show' ? 'active' : '' }}">
                    {{ ux_icon('lucide:folder-search', {class: 'icon-sm'}) }}
                    <span>{{ 'modo.menu.flagged_projects'|trans({}, 'admin') }}</span>
                    {% if count_flagged is defined and count_flagged > 0 %}
                        <span class="badge-count">{{ count_flagged }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('modo_report_list', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'modo_report' and current_route != 'modo_reports' ? 'active' : '' }}">
                    {{ ux_icon('lucide:triangle-alert', {class: 'icon-sm'}) }}
                    <span>{{ 'modo.menu.reports'|trans({}, 'admin') }}</span>
                    {% if count_pending_reports is defined and count_pending_reports > 0 %}
                        <span class="badge-count">{{ count_pending_reports }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('modo_comments', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'modo_comment' ? 'active' : '' }}">
                    {{ ux_icon('lucide:message-square', {class: 'icon-sm'}) }}
                    <span>{{ 'modo.menu.comments'|trans({}, 'admin') }}</span>
                </a>
            </nav>

            <footer class="modo-sidebar__footer">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard', {_locale: app.request.locale}) }}" class="sidebar-modo-link">
                        {{ ux_icon('lucide:shield', {class: 'icon-xs'}) }}
                        <span>{{ 'modo.menu.admin_panel'|trans({}, 'admin') }}</span>
                    </a>
                {% endif %}
                <span class="admin-user-pill admin-user-pill--modo">
                    {{ ux_icon('lucide:shield-check', {class: 'icon-xs'}) }}
                    {{ app.user.username ?? 'Modo' }}
                </span>
                <a href="{{ path('app_workshop_dashboard') }}" class="btn-exit-admin" data-turbo="false">
                    {{ ux_icon('lucide:log-out', {class: 'icon-xs'}) }}
                    {{ 'modo.exit'|trans({}, 'admin') }}
                </a>
            </footer>
        </aside>

        {# ── CONTENU ───────────────────────────────────────────────── #}
        <main class="modo-main">
            <div class="modo-content">
                <header class="modo-page-header">
                    <h1>{% block modo_title %}{{ 'modo.title'|trans({}, 'admin') }}{% endblock %}</h1>
                </header>

                {% for flash_type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="admin-flash admin-flash--{{ flash_type }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% block modo_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
