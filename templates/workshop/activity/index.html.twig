{% extends 'workshop/layout.html.twig' %}
{% trans_default_domain 'workshop' %}

{% block title %}Activité — Scénart{% endblock %}

{% block content %}

{# ── Méta-données par action (icône + couleur + label) ───────────── #}
{% set action_meta = {
    'project.create':     { icon: 'lucide:folder-plus',   color: 'green',  label: 'Projet créé' },
    'project.edit':       { icon: 'lucide:pencil',         color: 'blue',   label: 'Projet modifié' },
    'project.delete':     { icon: 'lucide:trash-2',        color: 'red',    label: 'Projet supprimé' },
    'project.publish':    { icon: 'lucide:globe',          color: 'yellow', label: 'Projet publié' },
    'manuscript.create':  { icon: 'lucide:file-plus',      color: 'green',  label: 'Scène créée' },
    'manuscript.edit':    { icon: 'lucide:file-edit',      color: 'blue',   label: 'Scène modifiée' },
    'manuscript.delete':  { icon: 'lucide:file-x',         color: 'red',    label: 'Scène supprimée' },
    'character.create':   { icon: 'lucide:user-plus',      color: 'green',  label: 'Personnage créé' },
    'character.edit':     { icon: 'lucide:user-pen',       color: 'blue',   label: 'Personnage modifié' },
    'character.delete':   { icon: 'lucide:user-x',         color: 'red',    label: 'Personnage supprimé' },
    'location.create':    { icon: 'lucide:map-pin-plus',   color: 'green',  label: 'Lieu créé' },
    'location.edit':      { icon: 'lucide:map-pin',        color: 'blue',   label: 'Lieu modifié' },
    'location.delete':    { icon: 'lucide:map-pin-off',    color: 'red',    label: 'Lieu supprimé' },
    'note.create':        { icon: 'lucide:notebook-pen',   color: 'green',  label: 'Note créée' },
    'note.edit':          { icon: 'lucide:notebook',       color: 'blue',   label: 'Note modifiée' },
    'note.delete':        { icon: 'lucide:notebook',       color: 'red',    label: 'Note supprimée' },
    'task.create':        { icon: 'lucide:square-plus',    color: 'green',  label: 'Tâche créée' },
    'task.complete':      { icon: 'lucide:circle-check',   color: 'green',  label: 'Tâche terminée' },
    'task.delete':        { icon: 'lucide:square-x',       color: 'red',    label: 'Tâche supprimée' },
    'world_event.create': { icon: 'lucide:calendar-plus',  color: 'green',  label: 'Événement créé' },
    'world_event.edit':   { icon: 'lucide:calendar',       color: 'blue',   label: 'Événement modifié' },
    'world_event.delete': { icon: 'lucide:calendar-x',     color: 'red',    label: 'Événement supprimé' },
} %}

{% set group_labels = {
    'today':      'Aujourd\'hui',
    'yesterday':  'Hier',
    'this_week':  'Cette semaine',
    'this_month': 'Ce mois-ci',
    'older':      'Plus ancien',
} %}

<div class="workspace-content">

    {# ── En-tête ─────────────────────────────────────────────────── #}
    <div class="act-header">
        <div>
            <a href="{{ path('app_workshop_dashboard', {_locale: app.request.locale}) }}" class="link-back">
                {{ ux_icon('lucide:arrow-left', {class: 'icon-xs'}) }}
                Tableau de bord
            </a>
            <h1>Activité récente</h1>
        </div>
        <span class="act-header__count">{{ total_count }} action{{ total_count > 1 ? 's' : '' }}</span>
    </div>

    {# ── Layout 2 colonnes ───────────────────────────────────────── #}
    <div class="act-layout">

        {# ── Sidebar catégories ──────────────────────────────────── #}
        <aside class="act-sidebar">
            <div class="act-sidebar__title">Catégories</div>
            <nav class="act-cat-nav">
                {% for key, cat in categories %}
                    {% set count = key == '' ? total_count : (category_counts[key] ?? 0) %}
                    {% if key == '' or count > 0 %}
                    <a href="{{ path('app_activity_log', {_locale: app.request.locale, category: key}) }}"
                       class="act-cat-item {{ category == key ? 'is-active' : '' }}">
                        <span class="act-cat-item__icon">
                            {{ ux_icon(cat.icon, {style: 'width:14px;height:14px'}) }}
                        </span>
                        <span class="act-cat-item__label">{{ cat.label }}</span>
                        {% if count > 0 %}
                        <span class="act-cat-item__count">{{ count }}</span>
                        {% endif %}
                    </a>
                    {% endif %}
                {% endfor %}
            </nav>
        </aside>

        {# ── Contenu principal ───────────────────────────────────── #}
        <main class="act-main">

            {% if activities is empty %}
                <div class="page-empty">
                    {{ ux_icon('lucide:activity', {style: 'width:44px;height:44px'}) }}
                    <h3>Aucune activité</h3>
                    <p>Aucune action trouvée pour cette catégorie.</p>
                </div>
            {% else %}

                {% for group_key, logs in grouped %}
                <section class="act-group">
                    <div class="act-group__header">
                        <span class="act-group__label">{{ group_labels[group_key] ?? group_key }}</span>
                        <span class="act-group__count">{{ logs|length }}</span>
                    </div>

                    <div class="act-group__items">
                        {% for log in logs %}
                            {% set meta = action_meta[log.action] ?? { icon: 'lucide:circle', color: 'muted', label: log.action } %}
                            {% set isSelf = log.user.id == app.user.id %}

                            <div class="act-item act-item--{{ meta.color }}">

                                {# Icône action #}
                                <span class="act-item__icon">
                                    {{ ux_icon(meta.icon, {style: 'width:15px;height:15px'}) }}
                                </span>

                                {# Corps #}
                                <div class="act-item__body">
                                    <div class="act-item__top">
                                        <span class="act-item__label">{{ meta.label }}</span>
                                        {% if log.description %}
                                            <span class="act-item__name">— {{ log.description }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="act-item__meta">
                                        {# Auteur de l'action #}
                                        <span class="act-item__who">
                                            {{ ux_icon('lucide:user', {style: 'width:11px;height:11px'}) }}
                                            {% if isSelf %}
                                                Moi
                                            {% else %}
                                                {{ log.user.username }}
                                            {% endif %}
                                        </span>
                                        {# Projet lié #}
                                        {% if log.project %}
                                            <span class="act-item__sep">·</span>
                                            <a href="{{ path('app_project_show', {_locale: app.request.locale, slug: log.project.slug}) }}"
                                               class="act-item__project">
                                                {{ ux_icon('lucide:folder', {style: 'width:11px;height:11px'}) }}
                                                {{ log.project.title }}
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Heure #}
                                <time class="act-item__time" datetime="{{ log.createdAt|date('c') }}"
                                      title="{{ log.createdAt|date('d/m/Y à H:i') }}">
                                    {{ log.createdAt|date('H:i') }}
                                </time>

                            </div>
                        {% endfor %}
                    </div>
                </section>
                {% endfor %}

            {% endif %}

        </main>

    </div>{# /.act-layout #}

</div>{# /.workspace-content #}

{% endblock %}
