{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'reset_password.browser_title'|trans }}{% endblock %}

{% block body %}
<div class="auth-fullpage">

    {% include 'website/_partials/_auth_brand.html.twig' %}

    <section class="auth-forms">
        <div class="auth-forms__inner">

            <div class="auth-form-panel auth-form-panel--centered">

                <h1 class="auth-form-title">{{ 'reset_password.title'|trans }}</h1>
                <p class="auth-form-subtitle">{{ 'reset_password.subtitle'|trans }}</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {{ component('Alert', { type: label, message: message }) }}
                    {% endfor %}
                {% endfor %}

                {{ form_start(resetForm, {'attr': {'novalidate': 'novalidate'}}) }}

                    {# Mot de passe + confirmation (même bloc qu'à l'inscription) #}
                    {% include 'website/auth/_password_fields.html.twig' with {
                        field: resetForm.plainPassword,
                        id_prefix: 'reset',
                        placeholder: 'reset_password.password'|trans,
                        placeholder_confirm: 'reset_password.password_confirm'|trans,
                        autofocus: true,
                    } only %}

                    <button type="submit" class="btn btn--cta-yellow auth-submit">
                        {{ 'reset_password.submit'|trans }}
                    </button>

                {{ form_end(resetForm) }}

            </div>

        </div>
    </section>

</div>
{% endblock %}
