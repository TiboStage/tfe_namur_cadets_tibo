{% extends 'workshop/projects/layout.html.twig' %}
{% trans_default_domain 'workshop' %}

{% block title %}Nouveau {{ config.labelSingular|lower }} — {{ project.title }}{% endblock %}

{% block project_content %}

{% set cfgIcon = config.hasContent ? 'lucide:file-text' : 'lucide:folder' %}
{% set maxDepth = max(configMap|keys) %}

<div class="workshop-container">

    <div class="ms-empty-start">

        {# ── Structure (gauche) ─────────────────────────────────────────── #}
        <div class="ms-empty-structure">
            <div class="ms-empty-structure-title">Structure de votre projet</div>
            <div class="ms-empty-levels">
                {% for d, lvl in configMap %}
                    {% set lvlIcon = lvl.hasContent ? 'lucide:file-text' : 'lucide:folder' %}
                    <div class="ms-empty-level {% if d == 1 %}ms-empty-level--first{% endif %} {% if d == depth %}ms-empty-level--active{% endif %}"
                         style="--lvl-color: {{ lvl.color }}">
                        <span class="ms-empty-level-icon">
                            {{ ux_icon(lvlIcon, {class: 'icon-xs', style: 'color: ' ~ lvl.color}) }}
                        </span>
                        <div class="ms-empty-level-text">
                            <strong>{{ lvl.labelPlural }}</strong>
                            <span>{{ lvl.hasContent ? 'contenu écrit' : 'structure' }}</span>
                        </div>
                        {% if d == depth %}
                            <span class="ms-empty-level-badge-active">création</span>
                        {% endif %}
                    </div>
                    {% if not loop.last %}
                        <div class="ms-empty-level-arrow">{{ ux_icon('lucide:arrow-down', {class: 'icon-xs'}) }}</div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        {# ── Formulaire (droite) ────────────────────────────────────────── #}
        <div class="ms-empty-form">

            {% if parent %}
                <p class="ms-new-context">
                    {{ ux_icon('lucide:corner-down-right', {class: 'icon-xs'}) }}
                    Dans <strong>{{ parent.title }}</strong>
                </p>
            {% endif %}

            <h2 class="ms-empty-form-title">
                Créez
                {% if parent %}un{% else %}votre premier{% endif %}
                <span style="color:{{ config.color }}">{{ config.labelSingular|lower }}</span>
            </h2>

            {% if error is defined and error %}
                <div class="ms-new-error">
                    {{ ux_icon('lucide:alert-circle', {class: 'icon-xs'}) }}
                    {{ error }}
                </div>
            {% endif %}

            <form method="post"
                  action="{{ path('app_manuscript_new', {project_slug: project.slug, depth: depth, parent_id: parent ? parent.id : null}) }}"
                  class="ms-empty-form-inner">
                <input type="text"
                       name="title"
                       class="ms-empty-input"
                       placeholder="{{ config.labelSingular }} {{ depth == 1 ? '1' : '' }}…"
                       autofocus
                       required>
                <button type="submit" class="ms-empty-submit">
                    {{ ux_icon('lucide:plus', {class: 'icon-xs'}) }} Créer
                </button>
            </form>

            {% if depth < maxDepth %}
                <p class="ms-empty-hint">
                    Vous ajouterez ensuite des <strong>{{ configMap[depth + 1].labelPlural|lower }}</strong> à l'intérieur.
                </p>
            {% else %}
                <p class="ms-empty-hint">
                    Le script s'ouvre directement après création.
                </p>
            {% endif %}

            <a href="{{ path('app_manuscript_index', {project_slug: project.slug}) }}"
               class="ms-new-cancel">
                {{ ux_icon('lucide:x', {class: 'icon-xs'}) }}
                Annuler
            </a>

        </div>

    </div>

</div>
{% endblock %}
