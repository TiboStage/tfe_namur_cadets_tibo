{# templates/admin/layout.html.twig #}
{% extends 'base.html.twig' %}

{% set current_route = app.request.attributes.get('_route') %}
{% set nav_counts = admin_nav_counts() %}

{% block body %}
    <div class="modo-layout" data-controller="confirm-modal">

        {# ── SIDEBAR (même structure que le panneau modo) ───────────── #}
        <aside class="modo-sidebar">

            <div class="modo-sidebar__header">
                <a href="{{ path('app_home') }}" class="logo-text logo-text--sm">SCÉN<span class="highlight">ART</span></a>
                <span class="brand-badge">Admin</span>
            </div>

            <nav class="modo-nav">
                <a href="{{ path('admin_dashboard', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route == 'admin_dashboard' ? 'active' : '' }}">
                    {{ ux_icon('lucide:layout-dashboard', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.dashboard'|trans({}, 'admin') }}</span>
                </a>
                <a href="{{ path('admin_users', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'admin_user' ? 'active' : '' }}">
                    {{ ux_icon('lucide:users', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.users'|trans({}, 'admin') }}</span>
                    <span class="modo-nav__count">{{ nav_counts.users }}</span>
                </a>
                <a href="{{ path('admin_projects', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'admin_project' ? 'active' : '' }}">
                    {{ ux_icon('lucide:folder', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.projects'|trans({}, 'admin') }}</span>
                    <span class="modo-nav__count">{{ nav_counts.projects }}</span>
                </a>
                <a href="{{ path('admin_moderation', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'admin_moderation' ? 'active' : '' }}">
                    {{ ux_icon('lucide:triangle-alert', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.moderation'|trans({}, 'admin') }}</span>
                    {% if nav_counts.flagged > 0 %}
                        <span class="modo-nav__count modo-nav__count--alert">{{ nav_counts.flagged }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('admin_config', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route == 'admin_config' ? 'active' : '' }}">
                    {{ ux_icon('lucide:settings-2', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.config'|trans({}, 'admin') }}</span>
                </a>
                <a href="{{ path('admin_doc_index', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'admin_doc_' ? 'active' : '' }}">
                    {{ ux_icon('lucide:book-open', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.documentation'|trans({}, 'admin') }}</span>
                    <span class="modo-nav__count">{{ nav_counts.documentation }}</span>
                </a>
                <a href="{{ path('admin_genre_index', {_locale: app.request.locale}) }}"
                   class="modo-nav__item {{ current_route starts with 'admin_genre' ? 'active' : '' }}">
                    {{ ux_icon('lucide:tag', {class: 'icon-sm'}) }}
                    <span>{{ 'layout.menu.genres'|trans({}, 'admin') }}</span>
                    <span class="modo-nav__count">{{ nav_counts.genres }}</span>
                </a>
            </nav>

            <footer class="modo-sidebar__footer">
                <a href="{{ path('modo_dashboard', {_locale: app.request.locale}) }}" class="sidebar-modo-link">
                    {{ ux_icon('lucide:shield-check', {class: 'icon-xs'}) }}
                    <span>{{ 'layout.menu.moderator_panel'|trans({}, 'admin') }}</span>
                </a>
                <span class="admin-user-pill">
                    {{ ux_icon('lucide:shield', {class: 'icon-xs'}) }}
                    {{ app.user.username ?? 'Admin' }}
                </span>
                <a href="{{ path('app_workshop_dashboard') }}" class="btn-exit-admin" data-turbo="false">
                    {{ ux_icon('lucide:log-out', {class: 'icon-xs'}) }}
                    {{ 'layout.exit'|trans({}, 'admin') }}
                </a>
            </footer>
        </aside>

        {# ── CONTENU ───────────────────────────────────────────────── #}
        <main class="modo-main">
            <div class="modo-content">
                <header class="modo-page-header">
                    <h1>{% block admin_title %}{{ 'layout.title'|trans({}, 'admin') }}{% endblock %}</h1>
                </header>

                {% for flash_type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="admin-flash admin-flash--{{ flash_type }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% block admin_content %}{% endblock %}
            </div>
        </main>

        {{ include('admin/_partials/_confirm_modal.html.twig') }}
    </div>
{% endblock %}
