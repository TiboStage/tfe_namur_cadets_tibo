{% extends 'workshop/projects/layout.html.twig' %}
{% trans_default_domain 'workshop' %}

{% block title %}{{ project.title }} — {{ 'manuscript.index.title'|trans }}{% endblock %}

{% macro renderNode(element, project, notesByElement, configMap, readonly) %}
    {% trans_default_domain 'workshop' %}
    {% import _self as ms %}

    {% if element.isLeaf() %}

        {% set notes = notesByElement[element.id] is defined ? notesByElement[element.id] : [] %}
        {% set wc = 0 %}
        {% for b in element.content %}
            {% if b.content is defined and b.content %}{% set wc = wc + (b.content|split(' ')|length) %}{% endif %}
        {% endfor %}

        {# Wrapper div pour que les boutons ↑↓ et le lien coexistent #}
        <div class="ms-script-item" data-sort-id="{{ element.id }}">
            <div class="ms-order-btns">
                <button type="button" class="ms-order-btn ms-order-btn--up"
                        title="Monter"
                        data-action="click->ms-reorder#up">
                    {{ ux_icon('lucide:chevron-up', {style: 'width:10px;height:10px;'}) }}
                </button>
                <button type="button" class="ms-order-btn ms-order-btn--down"
                        title="Descendre"
                        data-action="click->ms-reorder#down">
                    {{ ux_icon('lucide:chevron-down', {style: 'width:10px;height:10px;'}) }}
                </button>
            </div>
            <a href="{{ path('app_manuscript_show', {project_slug: project.slug, id: element.id}) }}"
               class="ms-script-row">
                <span class="ms-script-icon">{{ ux_icon('lucide:file-text', {class: 'icon-xs'}) }}</span>
                <span class="ms-script-title">{{ element.title }}</span>
                <span class="ms-script-meta">
                    {% if wc > 0 %}
                        <span class="ms-script-words">{{ wc }} {{ 'manuscript.index.stats.word'|trans({'%count%': wc}) }}</span>
                    {% else %}
                        <span class="ms-script-empty">{{ 'manuscript.index.tree.empty_folder'|trans }}</span>
                    {% endif %}
                    {% if notes|length > 0 %}
                        <span class="ms-note-chip">{{ ux_icon('lucide:notebook', {class: 'icon-xs'}) }}{{ notes|length }}</span>
                    {% endif %}
                </span>
            </a>
        </div>

    {% else %}

        {% set childDepth = element.depth + 1 %}
        {% set childConfig = configMap[childDepth] is defined ? configMap[childDepth] : null %}
        {% set hasChildren = element.children is not empty %}

        <div class="ms-folder ms-folder--depth-{{ element.depth > 3 ? 3 : element.depth }}"
             data-sort-id="{{ element.id }}"
             data-controller="ms-folder"
             data-ms-folder-id-value="{{ element.id }}">

            <div class="ms-folder-header">

                <div class="ms-order-btns">
                    <button type="button" class="ms-order-btn ms-order-btn--up"
                            title="Monter"
                            data-action="click->ms-reorder#up">
                        {{ ux_icon('lucide:chevron-up', {style: 'width:10px;height:10px;'}) }}
                    </button>
                    <button type="button" class="ms-order-btn ms-order-btn--down"
                            title="Descendre"
                            data-action="click->ms-reorder#down">
                        {{ ux_icon('lucide:chevron-down', {style: 'width:10px;height:10px;'}) }}
                    </button>
                </div>

                {% if hasChildren %}
                    <button type="button"
                            class="ms-chevron-btn"
                            data-action="click->ms-folder#toggle"
                            title="Réduire / développer">
                        {{ ux_icon('lucide:chevron-down', {class: 'ms-chevron icon-xs', 'data-ms-folder-target': 'chevron'}) }}
                    </button>
                {% else %}
                    <span class="ms-chevron-placeholder"></span>
                {% endif %}

                {{ ux_icon('lucide:folder-open', {class: 'icon-xs'}) }}

                <span data-controller="inline-rename"
                      data-inline-rename-url-value="{{ path('app_manuscript_rename', {project_slug: project.slug, id: element.id}) }}"
                      data-inline-rename-title-value="{{ element.title }}"
                      class="ms-folder-title-wrap">
                    <span class="ms-folder-title"
                          data-inline-rename-target="display"
                          data-action="dblclick->inline-rename#startEdit:prevent">{{ element.title }}</span>
                    <button type="button" class="ms-rename-btn" title="{{ 'manuscript.index.tree.rename'|trans }}"
                            data-action="click->inline-rename#startEdit">
                        {{ ux_icon('lucide:pencil', {style: 'width:10px;height:10px;'}) }}
                    </button>
                </span>

                <span class="ms-folder-type">{{ element.elementType|upper }}</span>
                <span class="ms-folder-count">
                    {{ element.children|length }} {{ 'manuscript.index.stats.script'|trans({'%count%': element.children|length}) }}
                </span>

                {% if childConfig and not readonly %}
                    <a href="{{ path('app_manuscript_new', {project_slug: project.slug, depth: childDepth, parent_id: element.id}) }}"
                       class="ms-folder-add" title="Ajouter {{ childConfig.labelSingular|lower }}">
                        {{ ux_icon('lucide:plus', {class: 'icon-xs'}) }}
                    </a>
                {% endif %}
            </div>

            {% if hasChildren %}
                <div class="ms-folder-body"
                     data-ms-folder-target="body"
                     data-controller="ms-reorder"
                     data-ms-reorder-url-value="{{ path('app_manuscript_reorder', {project_slug: project.slug}) }}"
                     data-sort-parent-id="{{ element.id }}">
                    {% for child in element.children %}
                        {{ ms.renderNode(child, project, notesByElement, configMap, readonly) }}
                    {% endfor %}
                </div>
            {% else %}
                {% if childConfig and not readonly %}
                <div class="ms-folder-empty">
                    <a href="{{ path('app_manuscript_new', {project_slug: project.slug, depth: childDepth, parent_id: element.id}) }}"
                       class="ms-folder-add-link">
                        {{ ux_icon('lucide:plus', {class: 'icon-xs'}) }}
                        Ajouter {{ childConfig.labelSingular|lower }}
                    </a>
                </div>
                {% endif %}
            {% endif %}

        </div>

    {% endif %}
{% endmacro %}

{% block project_content %}
{% import _self as ms %}

{% set rootConfig = configMap[1] is defined ? configMap[1] : null %}

<div class="workshop-container"
     data-controller="ms-export"
     data-ms-export-scripts-value="{{ leafScripts|json_encode|e('html_attr') }}"
     data-ms-export-project-title-value="{{ project.title|e('html_attr') }}">

    <header class="page-header">
        <div>
            <h1>
                {{ ux_icon('lucide:book-open', {class: 'icon-sm'}) }}
                {{ 'manuscript.index.title'|trans }}
                <span class="element-type-pill">{{ project.projectType|upper }}</span>
            </h1>
        </div>
        <div class="page-header-actions">
            {% if rootElements is not empty %}
                <button type="button" class="btn-outline-sm"
                        data-action="click->ms-export#togglePanel">
                    {{ ux_icon('lucide:download', {class: 'icon-xs'}) }}
                    Exporter
                </button>
            {% endif %}
            {% if rootConfig and rootElements is not empty and not (readonly ?? false) %}
                <a href="{{ path('app_manuscript_new', {project_slug: project.slug, depth: 1}) }}"
                   class="btn-export">
                    {{ ux_icon('lucide:plus', {class: 'icon-xs'}) }}
                    Nouveau {{ rootConfig.labelSingular|lower }}
                </a>
            {% endif %}
        </div>
    </header>

    {# ── Modal d'export global ──────────────────────────────────────── #}
    <div class="msex-modal" data-ms-export-target="modal" hidden>

        <div class="msex-modal__backdrop"
             data-action="click->ms-export#closeModal"></div>

        <div class="msex-modal__panel">

            {# ── En-tête ────────────────────────────────────────── #}
            <div class="msex-modal__header">
                <h2 class="msex-modal__title">
                    {{ ux_icon('lucide:download', {style: 'width:15px;height:15px'}) }}
                    Exporter le manuscrit
                </h2>
                <button type="button" class="msex-modal__close"
                        data-action="click->ms-export#closeModal"
                        aria-label="Fermer">
                    {{ ux_icon('lucide:x', {style: 'width:15px;height:15px'}) }}
                </button>
            </div>

            {# ── Corps ──────────────────────────────────────────── #}
            <div class="msex-modal__body">

                <p class="msex-modal__hint">
                    Sélectionnez les scripts à inclure et réordonnez-les avant d'exporter.
                </p>

                <div class="msex-modal__controls">
                    <button type="button" class="publish-modal__ctrl-btn"
                            data-action="click->ms-export#selectAll">Tout sélectionner</button>
                    <span class="msex-ctrl-sep">·</span>
                    <button type="button" class="publish-modal__ctrl-btn"
                            data-action="click->ms-export#selectNone">Tout désélectionner</button>
                    <span class="msex-count" data-ms-export-target="count"></span>
                </div>

                <div class="msex-list" data-ms-export-target="list">
                    {# Rendu dynamique par le contrôleur JS #}
                </div>

            </div>

            {# ── Pied ────────────────────────────────────────────── #}
            <div class="msex-modal__footer">
                <button type="button" class="publish-modal__btn-cancel"
                        data-action="click->ms-export#closeModal">
                    Annuler
                </button>
                <div class="msex-modal__footer-exports">
                    <button type="button" class="publish-modal__btn-save msex-btn--secondary"
                            data-action="click->ms-export#exportFountain">
                        {{ ux_icon('lucide:file-code', {class: 'icon-xs'}) }}
                        Fountain
                    </button>
                    <button type="button" class="publish-modal__btn-save"
                            data-action="click->ms-export#exportPDF">
                        {{ ux_icon('lucide:printer', {class: 'icon-xs'}) }}
                        Imprimer / PDF
                    </button>
                </div>
            </div>

        </div>
    </div>

    {% if rootElements is empty %}

        <div class="ms-empty-start">

            <div class="ms-empty-structure">
                <div class="ms-empty-structure-title">Structure de votre projet</div>
                <div class="ms-empty-levels">
                    {% for d, lvl in configMap %}
                        {% set lvlIcon = lvl.hasContent ? 'lucide:file-text' : 'lucide:folder' %}
                        <div class="ms-empty-level {% if d == 1 %}ms-empty-level--first{% endif %}" style="--lvl-color: {{ lvl.color }}">
                            <span class="ms-empty-level-icon">{{ ux_icon(lvlIcon, {class: 'icon-xs', style: 'color: ' ~ lvl.color}) }}</span>
                            <div class="ms-empty-level-text">
                                <strong>{{ lvl.labelPlural }}</strong>
                                <span>{{ lvl.hasContent ? 'contenu écrit' : 'structure' }}</span>
                            </div>
                        </div>
                        {% if not loop.last %}
                            <div class="ms-empty-level-arrow">{{ ux_icon('lucide:arrow-down', {class: 'icon-xs'}) }}</div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {% if rootConfig and not (readonly ?? false) %}
            <div class="ms-empty-form">
                <h2 class="ms-empty-form-title">
                    Créez votre premier
                    <span style="color:{{ rootConfig.color }}">{{ rootConfig.labelSingular|lower }}</span>
                </h2>
                <form method="post" action="{{ path('app_manuscript_new', {project_slug: project.slug, depth: 1}) }}" class="ms-empty-form-inner">
                    <input type="text" name="title" class="ms-empty-input" placeholder="{{ rootConfig.labelSingular }} 1…" autofocus required>
                    <button type="submit" class="ms-empty-submit">
                        {{ ux_icon('lucide:plus', {class: 'icon-xs'}) }} Créer
                    </button>
                </form>
                {% if configMap|length > 1 %}
                    <p class="ms-empty-hint">Vous ajouterez ensuite des <strong>{{ configMap[2].labelPlural|lower }}</strong> à l'intérieur.</p>
                {% endif %}
            </div>
            {% endif %}

        </div>

    {% else %}

        {% set allElements    = project.scenarioElements %}
        {% set totalScripts   = allElements|filter(e => e.isLeaf())|length %}
        {% set totalFolders   = allElements|filter(e => not e.isLeaf())|length %}
        {% set totalNoteCount = 0 %}
        {% for notes in notesByElement %}{% set totalNoteCount = totalNoteCount + notes|length %}{% endfor %}

        <div class="proj-show__stats ms-index-stats">
            <div class="proj-stat">
                {{ ux_icon('lucide:folder', {class: 'icon-xs'}) }}
                <strong>{{ totalFolders }}</strong>
                {{ 'manuscript.index.stats.folder'|trans({'%count%': totalFolders}) }}
            </div>
            <div class="proj-stat">
                {{ ux_icon('lucide:file-text', {class: 'icon-xs'}) }}
                <strong>{{ totalScripts }}</strong>
                {{ 'manuscript.index.stats.script'|trans({'%count%': totalScripts}) }}
            </div>
            <div class="proj-stat">
                {{ ux_icon('lucide:type', {class: 'icon-xs'}) }}
                <strong>{{ totalWordCount|number_format(0, ',', ' ') }}</strong>
                {{ 'manuscript.index.stats.word'|trans({'%count%': totalWordCount}) }}
            </div>
            {% if totalNoteCount > 0 %}
            <div class="proj-stat">
                {{ ux_icon('lucide:notebook', {class: 'icon-xs'}) }}
                <strong>{{ totalNoteCount }}</strong>
                {{ 'manuscript.index.stats.note'|trans({'%count%': totalNoteCount}) }}
            </div>
            {% endif %}
        </div>

        <div class="ms-overview-tree ms-overview-tree--flow"
             data-controller="ms-reorder"
             data-ms-reorder-url-value="{{ path('app_manuscript_reorder', {project_slug: project.slug}) }}"
             data-sort-parent-id="">

            {% for root in rootElements %}
                {{ ms.renderNode(root, project, notesByElement, configMap, readonly) }}
            {% endfor %}

            {% if rootConfig and not (readonly ?? false) %}
            <div class="ms-tree-add-root">
                <a href="{{ path('app_manuscript_new', {project_slug: project.slug, depth: 1}) }}" class="ms-tree-add-root-link">
                    {{ ux_icon('lucide:plus', {class: 'icon-xs'}) }}
                    Ajouter {{ rootConfig.labelSingular|lower }}
                </a>
            </div>
            {% endif %}
        </div>

    {% endif %}

</div>
{% endblock %}
