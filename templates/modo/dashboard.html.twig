{# templates/modo/dashboard.html.twig #}
{% extends 'modo/layout.html.twig' %}

{% block title %}Modo — Vue d'ensemble{% endblock %}
{% block modo_title %}Vue d'ensemble{% endblock %}

{% block modo_content %}

    {# ── KPI ──────────────────────────────────────────────────────── #}
    <div class="admin-stats-grid">

        <div class="admin-stat-card {{ count_pending_reports > 0 ? 'admin-stat-card--alert' : '' }}">
            <div class="asc-icon asc-icon--red">
                {{ ux_icon('lucide:triangle-alert', {style: 'width:22px;height:22px'}) }}
            </div>
            <div class="asc-body">
                <div class="asc-value">{{ count_pending_reports }}</div>
                <div class="asc-label">Signalement{{ count_pending_reports != 1 ? 's' : '' }} en attente</div>
                <div class="asc-sub">
                    <a href="{{ path('modo_report_list', {_locale: app.request.locale}) }}" class="asc-link">
                        Voir les signalements →
                    </a>
                </div>
            </div>
        </div>

        <div class="admin-stat-card {{ count_flagged > 0 ? 'admin-stat-card--alert' : '' }}">
            <div class="asc-icon asc-icon--yellow">
                {{ ux_icon('lucide:folder-search', {style: 'width:22px;height:22px'}) }}
            </div>
            <div class="asc-body">
                <div class="asc-value">{{ count_flagged }}</div>
                <div class="asc-label">Projet{{ count_flagged != 1 ? 's' : '' }} signalé{{ count_flagged != 1 ? 's' : '' }}</div>
                <div class="asc-sub">Sur {{ count_total }} projets au total</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="asc-icon asc-icon--muted">
                {{ ux_icon('lucide:message-square', {style: 'width:22px;height:22px'}) }}
            </div>
            <div class="asc-body">
                <div class="asc-value">{{ count_comments }}</div>
                <div class="asc-label">Commentaire{{ count_comments != 1 ? 's' : '' }}</div>
                <div class="asc-sub">
                    <a href="{{ path('modo_comments', {_locale: app.request.locale}) }}" class="asc-link">
                        Modérer →
                    </a>
                </div>
            </div>
        </div>

    </div>

    {# ── Signalements en attente ───────────────────────────────────── #}
    <div class="dash-panel" style="margin-bottom: 20px;">
        <div class="dash-panel__header">
            <h2>
                {{ ux_icon('lucide:triangle-alert', {style: 'width:13px;height:13px;color:#f87171'}) }}
                Signalements en attente
            </h2>
            <a href="{{ path('modo_report_list', {_locale: app.request.locale}) }}" class="link-more">
                Voir tous {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
            </a>
        </div>

        {% if recent_reports|length == 0 %}
            <div class="admin-empty-state">
                {{ ux_icon('lucide:circle-check', {style: 'width:36px;height:36px;color:#4ade80;opacity:.6'}) }}
                <p>Aucun signalement en attente. Beau travail !</p>
            </div>
        {% else %}
            <div class="table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Type / Cible</th>
                            <th>Raison</th>
                            <th>Signalé par</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for report in recent_reports|slice(0, 10) %}
                        <tr>
                            <td>
                                {% if report.targetType == 'project' %}
                                    <span class="tag-reason tag-reason--blue">Projet</span>
                                    <span class="report-target-label">
                                        {{ report.targetProject ? report.targetProject.title : '(supprimé)' }}
                                    </span>
                                {% elseif report.targetType == 'comment' %}
                                    <span class="tag-reason tag-reason--purple">Commentaire</span>
                                {% else %}
                                    <span class="tag-reason tag-reason--orange">Utilisateur</span>
                                    <span class="report-target-label">
                                        {{ report.targetUser ? report.targetUser.username : '(supprimé)' }}
                                    </span>
                                {% endif %}
                            </td>
                            <td><span class="tag-reason">{{ report.reasonLabel }}</span></td>
                            <td class="text-muted td-2xs">{{ report.reporter.username }}</td>
                            <td class="text-muted td-2xs">{{ report.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <a href="{{ path('modo_report_show', {id: report.id, _locale: app.request.locale}) }}"
                                   class="btn-table">Traiter</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# ── Projets avec flag (ancien système) ───────────────────────── #}
    {% if flagged|length > 0 %}
    <div class="dash-panel">
        <div class="dash-panel__header">
            <h2>
                {{ ux_icon('lucide:folder-search', {style: 'width:13px;height:13px'}) }}
                Projets avec flag de modération
            </h2>
            <a href="{{ path('modo_reports', {_locale: app.request.locale}) }}" class="link-more">
                Voir tous {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
            </a>
        </div>
        <div class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Projet</th>
                        <th>Auteur</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for project in flagged|slice(0, 5) %}
                    <tr>
                        <td><strong>{{ project.title }}</strong></td>
                        <td class="text-muted td-sm">{{ project.createdBy.username }}</td>
                        <td>
                            <span class="mod-badge mod-badge--{{ project.moderationStatus }}">
                                {{ project.moderationStatus }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('modo_project_show', {id: project.id, _locale: app.request.locale}) }}"
                               class="btn-table">Examiner</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

{% endblock %}
