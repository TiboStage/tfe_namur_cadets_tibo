{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Gestion des genres{% endblock %}

{% block admin_content %}
<div class="admin-section">

    <div class="admin-section-header">
        <div>
            <h2>{{ 'genre.list.title'|trans({}, 'admin') }}</h2>
            <p class="text-muted">
                Les genres apparaissent lors de la création et dans les paramètres de projet.
                Chaque genre requiert une traduction en FR, NL et EN.
            </p>
        </div>
        <a href="{{ path('admin_genre_new', {_locale: app.request.locale}) }}"
           class="btn btn--cta-yellow">
            + Nouveau genre
        </a>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="admin-flash admin-flash--success">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="admin-flash admin-flash--error">{{ msg }}</div>
    {% endfor %}

    {% if genres is empty %}
        <div class="admin-empty">
            Aucun genre défini. Créez le premier pour qu'il apparaisse dans le funnel de création.
        </div>
    {% else %}
    <table class="admin-table">
        <thead>
            <tr>
                <th>Ordre</th>
                <th>Slug</th>
                <th>Français</th>
                <th>Nederlands</th>
                <th>English</th>
                <th>Types</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for genre in genres %}
            <tr class="{{ not genre.isActive ? 'admin-row--inactive' : '' }}">
                <td class="text-muted">{{ genre.orderIndex }}</td>
                <td><code>{{ genre.slug }}</code></td>
                <td>{{ genre.getLabel('fr') }}</td>
                <td>{{ genre.getLabel('nl') }}</td>
                <td>{{ genre.getLabel('en') }}</td>
                <td>
                    {% set type_labels = {film: 'Film', serie: 'Série', jeu_video: 'Jeu vidéo', custom: 'Personnalisé'} %}
                    <div class="admin-badge-group">
                        {% if genre.projectTypes is empty %}
                            <span class="admin-badge admin-badge--neutral">Tous</span>
                        {% else %}
                            {% for type in genre.projectTypes %}
                                <span class="admin-badge admin-badge--type-{{ type }}">{{ type_labels[type] ?? type }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                </td>
                <td>
                    {% if genre.isActive %}
                        <span class="admin-badge admin-badge--success">Actif</span>
                    {% else %}
                        <span class="admin-badge admin-badge--muted">Inactif</span>
                    {% endif %}
                </td>
                <td>
                    <div class="admin-table__actions">
                    <a href="{{ path('admin_genre_edit', {_locale: app.request.locale, id: genre.id}) }}"
                       class="btn-sm btn-sm--outline">
                        {{ ux_icon('lucide:pencil', {class: 'icon-xs'}) }}
                        Modifier
                    </a>

                    {# Toggle actif / inactif #}
                    <form method="post"
                          action="{{ path('admin_genre_toggle', {_locale: app.request.locale, id: genre.id}) }}"
                          class="d-inline">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('genre_toggle_' ~ genre.id) }}">
                        {% if genre.isActive %}
                            <button type="submit" class="btn-sm btn-sm--ghost">
                                {{ ux_icon('lucide:eye-off', {class: 'icon-xs'}) }}
                                Désactiver
                            </button>
                        {% else %}
                            <button type="submit" class="btn-sm btn-sm--success">
                                {{ ux_icon('lucide:eye', {class: 'icon-xs'}) }}
                                Activer
                            </button>
                        {% endif %}
                    </form>

                    {# Suppression #}
                    <form method="post"
                          action="{{ path('admin_genre_delete', {_locale: app.request.locale, id: genre.id}) }}"
                          class="d-inline"
                          data-action="submit->confirm-modal#intercept"
                          data-confirm-title="Supprimer le genre « {{ genre.getLabel('fr') }} » ?"
                          data-confirm-message="Il disparaîtra des sélecteurs mais restera affiché sur les projets qui l'utilisent déjà."
                          data-confirm-label="Supprimer"
                          data-confirm-tone="danger">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('genre_delete_' ~ genre.id) }}">
                        <button type="submit" class="btn-sm btn-sm--danger">
                            {{ ux_icon('lucide:trash-2', {class: 'icon-xs'}) }}
                            {{ 'genre.btn.delete'|trans({}, 'admin') }}
                        </button>
                    </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}

</div>
{% endblock %}
