{% extends 'workshop/layout.html.twig' %}
{% trans_default_domain 'workshop' %}

{% block subnav %}{% endblock %}
{% block title %}{{ 'explore.home.title'|trans }} · Scénart{% endblock %}

{% block content %}

<div class="workshop-container explore-page">

    {# ══════════════════════════════════════════════════════════════════════
       ACCUEIL — hero + entrée vers la recherche approfondie
       ══════════════════════════════════════════════════════════════════════ #}
    <header class="explore-hero">
        <h1 class="explore-hero__title">{{ 'explore.home.title'|trans }}</h1>
        <p class="explore-hero__subtitle">{{ 'explore.home.subtitle'|trans }}</p>

        <form action="{{ path('app_workshop_search', {_locale: app.request.locale}) }}"
              method="get"
              class="explore-hero__search">
            {{ ux_icon('lucide:search', {class: 'icon-sm explore-hero__search-icon'}) }}
            <input type="text"
                   name="q"
                   class="explore-hero__search-input"
                   placeholder="{{ 'explore.home.search_placeholder'|trans }}"
                   autocomplete="off">
            <button type="submit" class="explore-hero__search-btn">
                {{ 'explore.home.search_btn'|trans }}
            </button>
        </form>

        <a href="{{ path('app_workshop_search', {_locale: app.request.locale}) }}"
           class="explore-hero__advanced">
            {{ ux_icon('lucide:sliders-horizontal', {class: 'icon-3xs'}) }}
            {{ 'explore.home.advanced'|trans }}
        </a>
    </header>

    {# ══════════════════════════════════════════════════════════════════════
       SECTIONS DÉCOUVERTE — aperçus, « Voir tous » mène à la recherche filtrée
       ══════════════════════════════════════════════════════════════════════ #}
    <div class="explore-discovery">

        {# ── Les derniers films ──────────────────────────────────────────── #}
        <section class="explore-section">
            <div class="dashboard-section-header">
                <h2>
                    {{ ux_icon('lucide:film', {class: 'icon-xs'}) }}
                    {{ 'explore.section.films'|trans }}
                </h2>
                <a href="{{ path('app_workshop_search', {_locale: app.request.locale, type: 'film', mode: 'projet'}) }}"
                   class="link-more">
                    {{ 'explore.section.see_all'|trans }} {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
                </a>
            </div>
            {% if latest_films is not empty %}
                <div class="sc-cards-grid">
                    {% for project in latest_films %}
                        {{ include('workshop/_partials/_project_card_public.html.twig', {
                            project:       project,
                            comment_count: comment_counts_map[project.id] ?? 0,
                            viewer_role:   viewer_roles_map[project.id] ?? null,
                        }) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="explore-section__empty">{{ 'explore.section.empty_films'|trans }}</p>
            {% endif %}
        </section>

        {# ── Les dernières séries ────────────────────────────────────────── #}
        <section class="explore-section">
            <div class="dashboard-section-header">
                <h2>
                    {{ ux_icon('lucide:tv-2', {class: 'icon-xs'}) }}
                    {{ 'explore.section.series'|trans }}
                </h2>
                <a href="{{ path('app_workshop_search', {_locale: app.request.locale, type: 'serie', mode: 'projet'}) }}"
                   class="link-more">
                    {{ 'explore.section.see_all'|trans }} {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
                </a>
            </div>
            {% if latest_series is not empty %}
                <div class="sc-cards-grid">
                    {% for project in latest_series %}
                        {{ include('workshop/_partials/_project_card_public.html.twig', {
                            project:       project,
                            comment_count: comment_counts_map[project.id] ?? 0,
                            viewer_role:   viewer_roles_map[project.id] ?? null,
                        }) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="explore-section__empty">{{ 'explore.section.empty_series'|trans }}</p>
            {% endif %}
        </section>

        {# ── Les derniers jeux vidéo ─────────────────────────────────────── #}
        <section class="explore-section">
            <div class="dashboard-section-header">
                <h2>
                    {{ ux_icon('lucide:gamepad-2', {class: 'icon-xs'}) }}
                    {{ 'explore.section.games'|trans }}
                </h2>
                <a href="{{ path('app_workshop_search', {_locale: app.request.locale, type: 'jeu_video', mode: 'projet'}) }}"
                   class="link-more">
                    {{ 'explore.section.see_all'|trans }} {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
                </a>
            </div>
            {% if latest_games is not empty %}
                <div class="sc-cards-grid">
                    {% for project in latest_games %}
                        {{ include('workshop/_partials/_project_card_public.html.twig', {
                            project:       project,
                            comment_count: comment_counts_map[project.id] ?? 0,
                            viewer_role:   viewer_roles_map[project.id] ?? null,
                        }) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="explore-section__empty">{{ 'explore.section.empty_games'|trans }}</p>
            {% endif %}
        </section>

        {# ── Studios & auteurs actifs ─────────────────────────────────────── #}
        {% if featured_creators is not empty %}
        <section class="explore-section">
            <div class="dashboard-section-header">
                <h2>
                    {{ ux_icon('lucide:award', {class: 'icon-xs'}) }}
                    {{ 'explore.section.creators'|trans }}
                </h2>
                <a href="{{ path('app_workshop_search', {_locale: app.request.locale, mode: 'auteur'}) }}"
                   class="link-more">
                    {{ 'explore.section.see_all'|trans }} {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
                </a>
            </div>
            <div class="sc-cards-grid">
                {% for row in featured_creators %}
                    {% set creator = row[0] %}
                    {% set count   = row.project_count %}
                    {{ include('workshop/_partials/_creator_card_search.html.twig', {
                        user:          creator,
                        project_count: count,
                    }) }}
                {% endfor %}
            </div>
        </section>
        {% endif %}

    </div>

</div>

{% endblock %}
