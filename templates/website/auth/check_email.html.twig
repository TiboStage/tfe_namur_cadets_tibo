{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}

{% block title %}{{ 'check_email.browser_title'|trans }}{% endblock %}

{% block body %}
<div class="auth-fullpage">

    {% include 'website/_partials/_auth_brand.html.twig' %}

    <section class="auth-forms">
        <div class="auth-forms__inner">

            <div class="auth-form-panel auth-form-panel--centered">

                <div class="auth-check-icon">
                    {{ ux_icon('lucide:mail-check', {style: 'width:26px;height:26px'}) }}
                </div>

                <h1 class="auth-form-title">{{ 'check_email.title'|trans }}</h1>
                <p class="auth-form-subtitle">{{ 'check_email.subtitle'|trans }}</p>
                <p class="auth-check-hint">{{ 'check_email.hint'|trans }}</p>

                {# Compteur de demandes + renvoi (seulement si on vient du formulaire) #}
                {% if remaining is not null %}
                    <div class="auth-resend">
                        <p class="auth-resend__count">
                            {{ 'check_email.counter'|trans({
                                '%used%': max_requests - remaining,
                                '%max%': max_requests,
                            }) }}
                        </p>

                        {% if remaining > 0 %}
                            <a href="{{ path('app_forgot_password_request', {_locale: app.request.locale}) }}"
                               class="btn btn--ghost auth-resend__btn"
                               data-controller="resend-countdown"
                               data-resend-countdown-seconds-value="{{ retry_in }}"
                               data-resend-countdown-label-value="{{ 'check_email.resend'|trans }}"
                               data-resend-countdown-waiting-value="{{ 'check_email.resend_in'|trans }}"
                               data-action="click->resend-countdown#guard">
                                {{ 'check_email.resend'|trans }}
                            </a>
                        {% else %}
                            <p class="auth-resend__limit">{{ 'check_email.limit_reached'|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                <a href="{{ path('app_login', {_locale: app.request.locale}) }}" class="auth-back-link">
                    {{ ux_icon('lucide:arrow-left', {style: 'width:13px;height:13px'}) }}
                    {{ 'check_email.back_to_login'|trans }}
                </a>

            </div>

        </div>
    </section>

</div>
{% endblock %}
