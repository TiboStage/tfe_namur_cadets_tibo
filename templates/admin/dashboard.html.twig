{# templates/admin/dashboard.html.twig #}
{% extends 'admin/layout.html.twig' %}

{% block title %}Admin — Vue d'ensemble{% endblock %}
{% block admin_title %}Vue d'ensemble{% endblock %}

{% block admin_content %}

    {# ── KPI ──────────────────────────────────────────────────────── #}
    <div class="admin-stats-grid">

        <div class="admin-stat-card">
            <div class="asc-icon asc-icon--blue">
                {{ ux_icon('lucide:users', {style: 'width:22px;height:22px'}) }}
            </div>
            <div class="asc-body">
                <div class="asc-value">{{ stats.users_total }}</div>
                <div class="asc-label">Utilisateurs</div>
                <div class="asc-sub">+{{ stats.users_new }} inscrits ce mois</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="asc-icon asc-icon--yellow">
                {{ ux_icon('lucide:folder', {style: 'width:22px;height:22px'}) }}
            </div>
            <div class="asc-body">
                <div class="asc-value">{{ stats.projects_total }}</div>
                <div class="asc-label">Projets</div>
                <div class="asc-sub">{{ stats.projects_public }} publics</div>
            </div>
        </div>

        <div class="admin-stat-card {{ stats.reports > 0 ? 'admin-stat-card--alert' : '' }}">
            <div class="asc-icon asc-icon--red">
                {{ ux_icon('lucide:triangle-alert', {style: 'width:22px;height:22px'}) }}
            </div>
            <div class="asc-body">
                <div class="asc-value">{{ stats.reports }}</div>
                <div class="asc-label">Signalements actifs</div>
                <div class="asc-sub">{{ stats.users_banned }} compte{{ stats.users_banned != 1 ? 's' : '' }} banni{{ stats.users_banned != 1 ? 's' : '' }}</div>
            </div>
        </div>

    </div>

    {# ── Panels ────────────────────────────────────────────────────── #}
    <div class="admin-panels-grid">

        {# ── Derniers inscrits ──────────────────────────────────────── #}
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2>
                    {{ ux_icon('lucide:user-plus', {style: 'width:13px;height:13px'}) }}
                    Derniers inscrits
                </h2>
                <a href="{{ path('admin_users', {_locale: app.request.locale}) }}" class="link-more">
                    Voir tous {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
                </a>
            </div>
            <div class="table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Email</th>
                            <th>Rôles</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in recent_users %}
                        <tr>
                            <td><strong>{{ user.username }}</strong></td>
                            <td class="text-muted td-sm">{{ user.email }}</td>
                            <td>
                                {% for role in user.roles %}
                                    {% if role != 'ROLE_USER' %}
                                        <span class="role-badge role-badge--{{ role|lower|replace({'role_': ''}) }}">
                                            {{ role|replace({'ROLE_': ''}) }}
                                        </span>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {% if user.isBanned %}
                                    <span class="status-badge status-badge--banned">Banni</span>
                                {% else %}
                                    <span class="status-badge status-badge--active">Actif</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('admin_user_show', {id: user.id, _locale: app.request.locale}) }}"
                                   class="btn-table">Voir</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="td-empty text-muted">Aucun utilisateur.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ── Projets signalés ───────────────────────────────────────── #}
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2>
                    {{ ux_icon('lucide:shield-alert', {style: 'width:13px;height:13px;color:#f87171'}) }}
                    Projets signalés
                </h2>
                <a href="{{ path('admin_moderation', {_locale: app.request.locale}) }}" class="link-more">
                    Voir tous {{ ux_icon('lucide:arrow-right', {class: 'icon-3xs'}) }}
                </a>
            </div>
            <div class="table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Projet</th>
                            <th>Auteur</th>
                            <th>Signals</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for project in flagged_projects %}
                        <tr>
                            <td><strong>{{ project.title }}</strong></td>
                            <td class="text-muted td-sm">{{ project.createdBy.username }}</td>
                            <td>
                                {% if project.reportCount > 0 %}
                                    <span class="tag-reason">{{ project.reportCount }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="mod-badge mod-badge--{{ project.moderationStatus }}">
                                    {{ project.moderationStatus }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('admin_project_show', {id: project.id, _locale: app.request.locale}) }}"
                                   class="btn-table">Inspecter</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="td-empty">
                                {{ ux_icon('lucide:circle-check', {style: 'width:16px;height:16px;color:#4ade80'}) }}
                                <span class="text-muted">Aucun signalement actif.</span>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>

{% endblock %}
