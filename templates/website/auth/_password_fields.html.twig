{#
    Bloc "nouveau mot de passe + confirmation", partagé par l'inscription
    (auth.html.twig) et la réinitialisation (reset_password.html.twig).

    - Premier champ : règles de caractères visibles d'emblée, masquées
      automatiquement quand elles sont toutes respectées.
    - Second champ : indique seulement s'il est identique au premier.
    Logique : assets/controllers/password_field_controller.js

    Variables :
      field               → le champ RepeatedType (ex. registrationForm.plainPassword)
      id_prefix           → préfixe d'id unique sur la page (ex. 'register')
      placeholder         → placeholder du premier champ (déjà traduit)
      placeholder_confirm → placeholder de la confirmation (déjà traduit)
      autofocus           → (optionnel) focus sur le premier champ
#}
{% trans_default_domain 'auth' %}

<div class="pw-group"
     data-controller="password-field"
     data-password-field-show-strength-value="true"
     data-password-field-has-confirm-value="true">

    <div class="auth-field">
        <div class="pw-input-wrap">
            {{ form_widget(field.first, {
                'attr': {
                    'placeholder': placeholder,
                    'data-password-field-target': 'input',
                    'data-action': 'input->password-field#checkStrength',
                    'aria-describedby': id_prefix ~ '-pw-rules',
                }|merge(autofocus|default(false) ? {'autofocus': 'autofocus'} : {})
            }) }}
            <button type="button"
                    class="pw-toggle-btn"
                    data-password-field-target="toggleBtn"
                    data-action="click->password-field#toggleVisibility"
                    aria-label="{{ 'show_password'|trans }}">
                <span class="pw-eye-show">{{ ux_icon('lucide:eye', {style: 'width:15px;height:15px'}) }}</span>
                <span class="pw-eye-hide" hidden>{{ ux_icon('lucide:eye-off', {style: 'width:15px;height:15px'}) }}</span>
            </button>
        </div>
        <div class="pw-strength" id="{{ id_prefix }}-pw-rules" data-password-field-target="strength" aria-live="polite">
            <div class="pw-rule" data-rule="length"    data-password-field-target="rule"><span class="pw-rule__dot"></span>{{ 'profile.form.rule_length'|trans }}</div>
            <div class="pw-rule" data-rule="uppercase" data-password-field-target="rule"><span class="pw-rule__dot"></span>{{ 'profile.form.rule_uppercase'|trans }}</div>
            <div class="pw-rule" data-rule="digit"     data-password-field-target="rule"><span class="pw-rule__dot"></span>{{ 'profile.form.rule_digit'|trans }}</div>
            <div class="pw-rule" data-rule="special"   data-password-field-target="rule"><span class="pw-rule__dot"></span>{{ 'profile.form.rule_special'|trans }}</div>
        </div>
        {# Erreurs des règles (portées par le champ répété) #}
        {{ form_errors(field) }}
        {{ form_errors(field.first) }}
    </div>

    <div class="auth-field">
        <div class="pw-input-wrap">
            {{ form_widget(field.second, {
                'attr': {
                    'placeholder': placeholder_confirm,
                    'data-password-field-target': 'confirm',
                    'data-action': 'input->password-field#checkMatch',
                }
            }) }}
            <button type="button"
                    class="pw-toggle-btn"
                    data-password-field-target="confirmToggleBtn"
                    data-action="click->password-field#toggleConfirmVisibility"
                    aria-label="{{ 'profile.form.password_show_confirm'|trans }}">
                <span class="pw-eye-show">{{ ux_icon('lucide:eye', {style: 'width:15px;height:15px'}) }}</span>
                <span class="pw-eye-hide" hidden>{{ ux_icon('lucide:eye-off', {style: 'width:15px;height:15px'}) }}</span>
            </button>
        </div>
        <p class="pw-match-status" data-password-field-target="matchStatus" aria-live="polite"></p>
        {{ form_errors(field.second) }}
    </div>

</div>
