{# templates/admin/projects/show.html.twig #}
{% extends 'admin/layout.html.twig' %}

{% block title %}Admin — {{ project.title }}{% endblock %}
{% block admin_title %}Détail du projet{% endblock %}

{% block admin_content %}
    {% embed 'admin/_partials/_project_review.html.twig' %}
        {% block back_link %}
            <a href="{{ path('admin_projects', {_locale: app.request.locale}) }}" class="admin-back-link">← Retour aux projets</a>
        {% endblock %}
        {% block actions %}
            {{ include('admin/_partials/_moderation_actions.html.twig', {
                action_url: path('admin_moderation_status', {id: project.id, _locale: app.request.locale}),
                token_id:   'mod_status_' ~ project.id,
                statuses:   ['clear', 'warning', 'blocked', 'approved'],
            }) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
